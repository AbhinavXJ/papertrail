{
  "name": "papertrail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "node scripts/serve.mjs 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm e2e && pnpm a11y",
    "a11y": "node scripts/a11y.mjs",
    "e2e:webkit": "BROWSER=webkit node scripts/e2e.mjs",
    "e2e:firefox": "BROWSER=firefox node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vercel/analytics": "2.0.1",
    "dompurify": "3.4.16",
    "idb": "8.0.3",
    "lucide-react": "1.48.0",
    "marked": "18.0.14",
    "next": "16.3.8",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.5",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
